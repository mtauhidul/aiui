{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "aiui",
  "homepage": "https://aiui.dev",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/registry/lib-utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "aiui theme",
      "description": "Color tokens the aiui components read. Optional: skip it if your own theme already defines them.",
      "cssVars": {
        "light": {
          "background": "#ffffff",
          "foreground": "#0a0a0a",
          "muted": "#f2f2ee",
          "muted-foreground": "#525252",
          "border": "rgb(0 0 0 / 0.12)",
          "accent": "#0a0a0a",
          "accent-foreground": "#fafaf5",
          "ring": "#0a0a0a"
        },
        "dark": {
          "background": "#000000",
          "foreground": "#efefe4",
          "muted": "#1a1a1a",
          "muted-foreground": "#a3a3a3",
          "border": "rgb(255 255 255 / 0.13)",
          "accent": "#efefe4",
          "accent-foreground": "#0a0a0a",
          "ring": "#efefe4"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority"
      ],
