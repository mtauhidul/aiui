{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_REGISTRY_URL",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/r/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {}
  }
}